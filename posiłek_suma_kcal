CREATE OR REPLACE TRIGGER TRG_UPDATE_POSILEK_KCAL
AFTER INSERT OR UPDATE OR DELETE ON SKLADNIK
FOR EACH ROW
DECLARE
    v_suma NUMBER(6,2);
BEGIN
    SELECT SUM(ILOSC_G * r.KCAL_NA_100G / 100)
    INTO v_suma
    FROM SKLADNIK s
    JOIN RODZAJ_SKLADNIKA r ON r.RODZAJ_SKLADNIKA_ID = s.RODZAJ_SKLADNIKA_ID
    WHERE s.POSILEK_ID = :NEW.POSILEK_ID;

    UPDATE POSILEK
    SET SUMA_KCAL = NVL(v_suma,0)
    WHERE POSILEK_ID = :NEW.POSILEK_ID;
END;
/
