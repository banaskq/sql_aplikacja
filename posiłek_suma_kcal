
CREATE OR REPLACE TRIGGER trg_update_posilek_kcal
AFTER INSERT OR UPDATE OR DELETE ON SKLADNIK
FOR EACH ROW 
DECLARE
    PRAGMA AUTONOMOUS_TRANSACTION; 
    v_suma NUMBER(10,2);
    v_posilek_id NUMBER;
BEGIN

    IF INSERTING OR UPDATING THEN
        v_posilek_id := :NEW.POSILEK_ID;
    ELSIF DELETING THEN
        v_posilek_id := :OLD.POSILEK_ID;
    END IF;


    SELECT NVL(SUM(s.ILOSC_G * r.KCAL_NA_100G / 100), 0)
    INTO v_suma
    FROM SKLADNIK s
    JOIN RODZAJ_SKLADNIKA r ON r.RODZAJ_SKLADNIKA_ID = s.RODZAJ_SKLADNIKA_ID
    WHERE s.POSILEK_ID = v_posilek_id;

    UPDATE POSILEK
    SET SUMA_KCAL = v_suma
    WHERE POSILEK_ID = v_posilek_id;

    COMMIT; 
END;
/
