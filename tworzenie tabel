--------------------------------------------------
-- UZYTKOWNIK
--------------------------------------------------
CREATE TABLE UZYTKOWNIK (
    UZYTKOWNIK_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    IMIE VARCHAR2(50) NOT NULL,
    NAZWISKO VARCHAR2(50) NOT NULL,
    PLEC VARCHAR2(10) NOT NULL,
    WIEK NUMBER(3) NOT NULL,
    MASA_CIALA NUMBER(5,2) NOT NULL,
    WZROST NUMBER(3) NOT NULL
);

--------------------------------------------------
-- RODZAJ AKTYWNOSCI
--------------------------------------------------
CREATE TABLE RODZAJ_AKTYWNOSCI (
    RODZAJ_AKTYWNOSCI_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    NAZWA VARCHAR2(50) NOT NULL,
    SPALONE_KCAL_NA_GODZ NUMBER(6) NOT NULL
);

--------------------------------------------------
-- AKTYWNOSC
--------------------------------------------------
CREATE TABLE AKTYWNOSC (
    AKTYWNOSC_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    CZAS_MIN NUMBER(4) NOT NULL,
    DATA DATE NOT NULL,
    UZYTKOWNIK_ID NUMBER NOT NULL,
    RODZAJ_AKTYWNOSCI_ID NUMBER NOT NULL,
    CONSTRAINT FK_AKTYWNOSC_USER FOREIGN KEY (UZYTKOWNIK_ID)
        REFERENCES UZYTKOWNIK(UZYTKOWNIK_ID),
    CONSTRAINT FK_AKTYWNOSC_RODZAJ FOREIGN KEY (RODZAJ_AKTYWNOSCI_ID)
        REFERENCES RODZAJ_AKTYWNOSCI(RODZAJ_AKTYWNOSCI_ID)
);

