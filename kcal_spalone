CREATE OR REPLACE TRIGGER trg_update_kcal_spalone
AFTER INSERT OR UPDATE OR DELETE ON AKTYWNOSC
DECLARE
BEGIN
    MERGE INTO PODSUMOWANIE_DNIA PD
    USING (
        SELECT 
            A.UZYTKOWNIK_ID,
            A.DATA,
            SUM(A.CZAS_MIN / 60 * R.SPALONE_KCAL_NA_GODZ) AS KCAL_SPALONE
        FROM AKTYWNOSC A
        JOIN RODZAJ_AKTYWNOSCI R
            ON A.RODZAJ_AKTYWNOSCI_ID = R.RODZAJ_AKTYWNOSCI_ID
        GROUP BY A.UZYTKOWNIK_ID, A.DATA
    ) SRC
    ON (PD.UZYTKOWNIK_ID = SRC.UZYTKOWNIK_ID AND PD.DATA = SRC.DATA)
    WHEN MATCHED THEN 
        UPDATE SET PD.KCAL_SPALONE = SRC.KCAL_SPALONE
    WHEN NOT MATCHED THEN
        INSERT (PODSUMOWANIE_ID, UZYTKOWNIK_ID, DATA, KCAL_PRZYJETE, KCAL_SPALONE)
        VALUES (PODSUMOWANIE_SEQ.NEXTVAL, SRC.UZYTKOWNIK_ID, SRC.DATA, 0, SRC.KCAL_SPALONE);
END;
/
